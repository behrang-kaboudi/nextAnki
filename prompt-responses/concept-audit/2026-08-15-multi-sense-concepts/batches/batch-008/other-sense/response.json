  "results": [
    {
      "id": 35618,
      "concept_explained_fa": "پایین‌رفتن در آب یا مادهٔ نرم، معمولاً بر اثر وزن؛ همچنین کاهش تدریجی سطح یا وضعیت."
    },
    {
      "id": 35626,
      "concept_explained_fa": "به به‌دست آوردن پول، دانش، مزیت، وزن یا چیز ارزشمند در طول زمان اشاره دارد."
    },
    {
      "id": 35627,
      "concept_explained_fa": "یک قطره مایع یا، در کاربرد مجازی، مقدار بسیار کمی از چیزی."
    },
    {
      "id": 35652,
      "concept_explained_fa": "کامل و مطلق از نظر درجه یا ویژگی، یا دارای همه اجزای لازم؛ معنای دقیق به اسم و بافت بستگی دارد."
    },
    {
      "id": 35688,
      "concept_explained_fa": "توانایی و عمل سخن گفتن، یا سخنرانی رسمی برای مخاطبان، است."
    },
    {
      "id": 35692,
      "concept_explained_fa": "شکلی از دو خط متقاطع است که نماد اصلی دین مسیحیت نیز محسوب می‌شود."
    },
    {
      "id": 35915,
      "concept_explained_fa": "اندک و جزئی از نظر مقدار، درجه یا تفاوت؛ گاهی دربارهٔ اندام باریک نیز به‌کار می‌رود."
    },
    {
      "id": 35928,
      "concept_explained_fa": "به اندازه‌گیری وزن شخص یا چیزی با ترازو، یا سنجیدن اهمیت گزینه‌ها، اشاره دارد."
    },
    {
      "id": 35940,
      "concept_explained_fa": "به تخریب ساختمان یا ساختار تا افتادن آن، یا زمین زدن شخص، اشاره دارد."
    },
    {
      "id": 36108,
      "concept_explained_fa": "به ایجاد نگرانی یا مزاحمت برای شخص، یا زحمت انجام کاری، اشاره دارد."
    },
    {
      "id": 36449,
      "concept_explained_fa": "فرایند، شیوه یا نظام اداره و کنترل یک کشور یا جامعه و اجرای تصمیم‌های عمومی؛ می‌تواند به خود نهاد حاکم نیز اشاره کند."
    },
    {
      "id": 36626,
      "concept_explained_fa": "به اندام پرواز پرندگان و حشرات یا بخش مشابه در دو سوی هواپیما اشاره دارد."
    },
    {
      "id": 36659,
      "concept_explained_fa": "به عمل دریافت پول، کالا یا پیام اشاره دارد؛ همچنین می‌تواند مدرک پرداخت باشد."
    }
  ]
}
