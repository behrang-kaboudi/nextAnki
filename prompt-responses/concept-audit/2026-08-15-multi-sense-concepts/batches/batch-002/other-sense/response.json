  "results": [
    {
      "id": 2567,
      "concept_explained_fa": "نقش یا اثر چاپ‌شده با مهر، یا خود ابزار ایجاد آن؛ همچنین تمبر پستی."
    },
    {
      "id": 2713,
      "concept_explained_fa": "زباله و مواد دورریختنی به‌طور کلی در آمریکای شمالی؛ مجازاً برای چیز یا محتوای بی‌ارزش نیز به کار می‌رود."
    },
    {
      "id": 2722,
      "concept_explained_fa": "الیاف نرم طبیعی گیاه پنبه یا پارچه و منسوجی که از این الیاف ساخته می‌شود."
    },
    {
      "id": 2766,
      "concept_explained_fa": "نمای اصلی و معمولاً جلویی ساختمان؛ همچنین ظاهر ظاهری پنهان‌کنندهٔ واقعیت"
    },
    {
      "id": 3043,
      "concept_explained_fa": "کار شستن لباس ها یا محل خدمات شستشو؛ نام دستگاه نیست"
    },
    {
      "id": 3549,
      "concept_explained_fa": "نشان رسمی برای تأیید یا بستن، یا وسیله‌ای که از بازشدن و نفوذ جلوگیری می‌کند."
    },
    {
      "id": 3550,
      "concept_explained_fa": "واحد استاندارد اندازه‌گیری طول؛ همچنین نام برخی دستگاه‌های اندازه‌گیری، نه خود نوار اندازه‌گیری."
    },
    {
      "id": 3594,
      "concept_explained_fa": "ماده سخت غیرفلزی ساخته شده با پخت خاک رس؛ همچنین شیء ساخته شده از آن"
    },
    {
      "id": 3600,
      "concept_explained_fa": "ابزار یا صدای تیز و کوتاهی است که برای هشدار یا اعلام استفاده می‌شود."
    },
    {
      "id": 3690,
      "concept_explained_fa": "قطعه کوچک روی لباس برای بستن آن یا روی دستگاه و رابط برای فعال‌کردن یک فرمان؛ معنای عمومی دکمه."
    },
    {
      "id": 3752,
      "concept_explained_fa": "در آمریکای شمالی به پریز دیواری برق گفته می‌شود؛ بدون بافت می‌تواند معانی دیگری مانند محل فروش نیز داشته باشد."
    },
    {
      "id": 3768,
      "concept_explained_fa": "مایع روغنی؛ بسته به زمینه می‌تواند نفت، روغن خوراکی، روان‌کننده یا ماده نفتی باشد."
    },
    {
      "id": 3775,
      "concept_explained_fa": "مبلغ پرداختی دوره ای برای استفاده از ملک یا وسیله؛ همچنین عمل اجاره کردن"
    },
    {
      "id": 3794,
      "concept_explained_fa": "ماده‌ای در حالت گازی؛ همچنین به سوخت گازی مانند گاز طبیعی برای گرمایش یا پخت‌وپز اشاره می‌کند."
    },
    {
      "id": 3817,
      "concept_explained_fa": "به پیام مسیحیت دربارهٔ زندگی و تعالیم عیسی یا یکی از چهار کتاب نخست عهد جدید اشاره دارد."
    },
    {
      "id": 3914,
      "concept_explained_fa": "چارچوب استخوانی بدن انسان یا جانور؛ همچنین ساختار اصلی و بدون پوشش"
    },
    {
      "id": 4253,
      "concept_explained_fa": "کسی را با مراسم، خداحافظی یا آرزوی خوب راهی کردن؛ همچنین چیزی را ارسال کردن"
    },
    {
      "id": 4267,
      "concept_explained_fa": "مقدار یا مجموعه چیزی که شخص، وسیله یا سازه حمل یا تحمل می‌کند؛ می‌تواند جسمی، کاری یا فنی باشد."
    },
    {
      "id": 4293,
      "concept_explained_fa": "یعنی با وجود ابهام، فاصله، نور کم یا دشواری، چیزی را دید، تشخیص داد یا مفهوم آن را فهمید."
    },
    {
      "id": 4338,
      "concept_explained_fa": "برای نسبت دادن منشأ یا اختیار چیزی به خدا یا نیرویی فرابشری استفاده می‌شود؛ مرتبط با خدا یا نیروهای ماورایی فراتر از انسان."
    },
    {
      "id": 4378,
      "concept_explained_fa": "رد، نقش یا اثری که تماس، فشار یا حضور چیزی روی سطح یا ذهن باقی می‌گذارد."
    },
    {
      "id": 4417,
      "concept_explained_fa": "قرارداد رسمی اجاره برای مدت و شرایط مشخص؛ همچنین مدت تصرف قراردادی"
    }
  ]
}
