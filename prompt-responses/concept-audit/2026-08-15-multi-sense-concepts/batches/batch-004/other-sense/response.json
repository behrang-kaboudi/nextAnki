  "results": [
    {
      "id": 5575,
      "concept_explained_fa": "برای نشان‌دادن جهت یا نزدیکی تقریبی به مکانی استفاده می‌شود، نه نقطه دقیق؛ در زمان، به نزدیکی یک نقطه یا دوره اشاره می‌کند، بدون تعیین لحظه دقیق."
    },
    {
      "id": 5609,
      "concept_explained_fa": "عمل ثبت و ارائه رسمی سند یا درخواست؛ اسم و مرتبط با تشکیل دادن اجزا نیست"
    },
    {
      "id": 5723,
      "concept_explained_fa": "بلا یا مشکل فراگیر و مداومی که افراد زیادی را آزار می‌دهد؛ همچنین نام بیماری همه‌گیر تاریخی"
    },
    {
      "id": 5812,
      "concept_explained_fa": "مربوط به خدا یا نیروی الهی؛ همچنین برای چیزی بسیار عالی یا آسمانی به‌صورت مجازی"
    },
    {
      "id": 5973,
      "concept_explained_fa": "راه یا خیابانی معمولاً آرام و مسکونی، به‌ویژه در نام مکان‌ها؛ گاهی نیز مسیر خصوصی ورود خودرو به خانه را می‌رساند."
    },
    {
      "id": 5976,
      "concept_explained_fa": "در نشانی های شهری، به مسیر کوتاه و آرام محله ای گفته می شود، نه تراس ساختمان."
    },
    {
      "id": 6073,
      "concept_explained_fa": "دارای فاصله کم مکانی، زمانی یا عاطفی؛ صفت"
    },
    {
      "id": 29969,
      "concept_explained_fa": "چیزی که از راه گفتار و دهان منتقل یا انجام می‌شود، در برابر نوشتاری؛ در پزشکی نیز معنی مربوط به دهان دارد."
    },
    {
      "id": 30027,
      "concept_explained_fa": "به تنوع گزینه‌ها یا فاصلهٔ میان دو حد در یک مجموعه اشاره دارد."
    },
    {
      "id": 30284,
      "concept_explained_fa": "به جداکردن یا رهاکردن پوشش، مو، برگ یا اشک از بدن یا سطح اشاره دارد."
    },
    {
      "id": 30441,
      "concept_explained_fa": "گروه انسان‌هایی با دوره تولد نزدیک یا مرحله مشابه در توالی خانوادگی؛ همچنین برای نسل فناوری و محصولات به‌کار می‌رود."
    },
    {
      "id": 30641,
      "concept_explained_fa": "مجموعه سازمان‌یافته اسناد و داده‌های تاریخی، یا محل و سامانه نگهداری و دسترسی به آنها است."
    },
    {
      "id": 30756,
      "concept_explained_fa": "به پایان رسمی خدمت نظامی یا اقامت درمانی و اجازه خروج فرد از آن نهاد اشاره دارد."
    }
  ]
