generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  banned
}

enum PictureWordType {
  noun
  adding
  animal
  person
  occupation
  notPersonal
  humanBody
  relationalObj
  personAdj
  personAdj_adj
  adj
  food
  place
  accessory
  tool
  sport
}

enum PictureWordUsage {
  Job
  adj
  person
  free
  notSet
}

model Word {
  id                                     Int          @id @default(autoincrement())
  anki_link_id                           String       @unique(map: "Word_anki_link_id_key")
  englishId                              Int
  meaningId                              Int?
  otherMeaningIds                        Json?
  /// Unique Word.id values already compared with this record for semantic similarity.
  comparedMeaningWordIds                 Json?
  /// Unique Word.id values confirmed to have a semantic relationship with this record.
  synonymIds                             Json?
  /// Unique Sentence.id values where this word is used with its primary meaning.
  sentenceIds                            Json?
  /// True after this Word has passed the Word Concept Merge workflow.
  conceptMergeReviewed                   Boolean      @default(false)
  meanings_confirmed                     Boolean      @default(false)
  pos                                    String?
  concept_explained_fa                   String?      @db.Text
  concept_explained_fa_audio_file_name   String?
  concept_explained_fa_audio_source_text String?      @db.Text
  learning_depth                         Float?
  other_meanings_en                      String?
  category                               String?
  hint_to_select                         String?
  /// Score 0-100: how imageable/visual the word is (NULL means unset).
  imageability                           Int?
  /// Productive target score 0-101 (NULL means unset).
  productive_target                      Int?
  createdAt                              DateTime     @default(now())
  updatedAt                              DateTime     @updatedAt
  english                                EnglishWord  @relation("WordEnglish", fields: [englishId], references: [id], onDelete: Restrict)
  meaning                                PersianWord? @relation("WordPrimaryPersianMeaning", fields: [meaningId], references: [id], onDelete: SetNull)

  @@index([englishId], map: "Word_englishId_idx")
  @@index([meaningId], map: "Word_meaningId_idx")
  @@index([conceptMergeReviewed], map: "Word_conceptMergeReviewed_idx")
  @@map("word")
}

/// Preserves values removed from Word during the 20260805 schema cleanup.
model WordRemovedFieldArchive {
  wordId                           Int      @id
  concept_explained                String?
  word_hint_story                  String?
  explanation_for_sentence_meaning String?
  mixed_sentence                   String?
  typeOfWordInDb                   String
  hint_sentence                    String?
  first_letter_en_hint             String?
  first_letter_fa_hint             String?
  word_note                        String?
  common_error                     String?
  archivedAt                       DateTime @default(now())

  @@map("word_removed_field_archive")
}

model EnglishWord {
  id                     Int      @id @default(autoincrement())
  base_form              String   @unique(map: "EnglishWord_base_form_key")
  phonetic_us            String?
  phonetic_us_normalized String?
  json_hint              String?  @db.LongText
  audio_file_name        String?
  audio_source_text      String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  words                  Word[]   @relation("WordEnglish")

  @@index([phonetic_us_normalized], map: "EnglishWord_phonetic_us_normalized_idx")
  @@map("english_word")
}

model Sentence {
  id                                       Int      @id @default(autoincrement())
  sentence_en                              String   @unique
  sentence_en_meaning_fa                   String?
  sentence_en_audio_file_name              String?
  sentence_en_audio_source_text            String?  @db.Text
  sentence_en_meaning_fa_audio_file_name   String?
  sentence_en_meaning_fa_audio_source_text String?  @db.Text
  createdAt                                DateTime @default(now())
  updatedAt                                DateTime @updatedAt
}

model IpaKeyword {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  fa        String
  faPlain   String   @default("")
  ipa_fa    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fa])
  @@index([faPlain])
}

model PersianWord {
  id                       Int      @id @default(autoincrement())
  canonical_text           String
  normalized_text          String
  not_normalized_texts     Json
  meaning_fa_IPA           String?
  meaning_fa_IPA_normalize String?
  audio_file_name          String?
  audio_source_text        String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  primaryMeaningWords      Word[]   @relation("WordPrimaryPersianMeaning")

  @@index([canonical_text], map: "PersianWord_canonical_text_idx")
  @@index([normalized_text], map: "PersianWord_normalized_text_idx")
  @@map("persian_word")
}

model PictureWord {
  id                Int              @id @default(autoincrement())
  fa                String
  ipa_fa            String
  ipa_fa_normalized String           @default("")
  phinglish         String
  en                String
  type              PictureWordType  @default(noun)
  usage             PictureWordUsage @default(notSet)
  canBePersonal     Boolean          @default(false)
  ipaVerified       Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([fa, en])
  @@index([fa])
  @@index([en])
}

model AnkiStructureSettings {
  id        String   @id @default("default")
  config    Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A locally served chat model and its OpenAI-compatible generation defaults.
model AiModel {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  provider        String   @default("lm_studio")
  modelIdentifier String
  baseUrl         String   @default("http://localhost:1234/v1")
  systemPrompt    String?  @db.Text
  settings        Json
  isEnabled       Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([provider, isEnabled])
  @@index([modelIdentifier])
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  status         UserStatus @default(active)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  accounts       Account[]
  sessions       Session[]
  roles          UserRole[]
  passwordResets PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}
