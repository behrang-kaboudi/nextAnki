[
  {
    "id": 69391,
    "canonical_text": "زمان را به عقب برگرداندن"
  },
  {
    "id": 69392,
    "canonical_text": "کار خود را کردن (علیرغم مخالفت دیگران)"
  },
  {
    "id": 69393,
    "canonical_text": "نمایش افتتاحیه"
  },
  {
    "id": 69394,
    "canonical_text": "نخستین اجرا"
  },
  {
    "id": 69395,
    "canonical_text": "صدای تلق (بسته شدن چفت درب و...)"
  },
  {
    "id": 69396,
    "canonical_text": "صدای خرت خرت"
  },
  {
    "id": 69397,
    "canonical_text": "صدای قرچ قرچ"
  },
  {
    "id": 69398,
    "canonical_text": "با روند کند"
  },
  {
    "id": 69399,
    "canonical_text": "وقت پر کردن"
  },
  {
    "id": 69400,
    "canonical_text": "مخارج اصلی زندگی"
  },
  {
    "id": 69401,
    "canonical_text": "هزینه زندگی"
  },
  {
    "id": 69402,
    "canonical_text": "بیشتر از وسع خود خرج کردن"
  },
  {
    "id": 69403,
    "canonical_text": "به میزان انبوه تولیدشده"
  },
  {
    "id": 69405,
    "canonical_text": "تماس از دست رفته"
  },
  {
    "id": 69406,
    "canonical_text": "تلفن عمومی"
  },
  {
    "id": 69407,
    "canonical_text": "تلفن سکه‌ای"
  },
  {
    "id": 69411,
    "canonical_text": "معتاد شدن"
  },
  {
    "id": 69412,
    "canonical_text": "دچار وسواس فکری"
  },
  {
    "id": 69414,
    "canonical_text": "با تمام علایم (بیماری)"
  },
  {
    "id": 69415,
    "canonical_text": "تنگ ماهی"
  },
  {
    "id": 69416,
    "canonical_text": "مثل سگ کار کردن"
  },
  {
    "id": 69417,
    "canonical_text": "به شدت زحمت کشیدن"
  },
  {
    "id": 69418,
    "canonical_text": "نامزد انتخاباتی کمتر شناخته شده"
  },
  {
    "id": 69420,
    "canonical_text": "فلفل تند"
  },
  {
    "id": 69422,
    "canonical_text": "دودی (غذا)"
  },
  {
    "id": 69423,
    "canonical_text": "سینی فر"
  },
  {
    "id": 69424,
    "canonical_text": "آب شده"
  },
  {
    "id": 69425,
    "canonical_text": "ذوب شده"
  },
  {
    "id": 69426,
    "canonical_text": "مذاب"
  },
  {
    "id": 69428,
    "canonical_text": "پرشده (از ماده ای)"
  },
  {
    "id": 69430,
    "canonical_text": "آکنده"
  },
  {
    "id": 69431,
    "canonical_text": "گوشت (میوه)"
  },
  {
    "id": 69433,
    "canonical_text": "کارت عضویت کتابخانه"
  },
  {
    "id": 69435,
    "canonical_text": "ماه های سال"
  },
  {
    "id": 69436,
    "canonical_text": "آیا او پدر شماست؟"
  },
  {
    "id": 69437,
    "canonical_text": "خوب به نظر می آید."
  },
  {
    "id": 69438,
    "canonical_text": "اهل آمریکای جنوبی"
  },
  {
    "id": 69439,
    "canonical_text": "آیا اهل ایران هستید؟"
  },
  {
    "id": 69440,
    "canonical_text": "به کتابخانه رفتن"
  },
  {
    "id": 69441,
    "canonical_text": "سر زدن به فامیل"
  },
  {
    "id": 69442,
    "canonical_text": "دیدن خویشاوندان"
  },
  {
    "id": 69443,
    "canonical_text": "کوهنوردی کردن"
  },
  {
    "id": 69444,
    "canonical_text": "از کوه بالا رفتن"
  },
  {
    "id": 69445,
    "canonical_text": "رفتن به باشگاه"
  },
  {
    "id": 69447,
    "canonical_text": "والیبال بازی کردن"
  },
  {
    "id": 69448,
    "canonical_text": "بازی کردن در فیلم های سینمایی"
  },
  {
    "id": 69449,
    "canonical_text": "چرا که نه؟"
  },
  {
    "id": 69452,
    "canonical_text": "آیا آنها می توانند بسکتبال بازی کنند؟"
  },
  {
    "id": 69453,
    "canonical_text": "آیا آنها بلد هستند بسکتبال بازی کنند؟"
  },
  {
    "id": 69454,
    "canonical_text": "می توانی نقاشی بکشی؟"
  },
  {
    "id": 69455,
    "canonical_text": "نقاشی کشیدن بلدی؟"
  },
  {
    "id": 69456,
    "canonical_text": "با کامپیوتر کار کردن"
  },
  {
    "id": 69457,
    "canonical_text": "چای درست کردن"
  },
  {
    "id": 69458,
    "canonical_text": "شطرنج بازی کردن"
  },
  {
    "id": 69459,
    "canonical_text": "مشکل سلامتی"
  },
  {
    "id": 69463,
    "canonical_text": "تب داشتن"
  },
  {
    "id": 69464,
    "canonical_text": "چه شده است؟"
  },
  {
    "id": 69465,
    "canonical_text": "چه مشکلی پیش آمده است؟"
  },
  {
    "id": 69466,
    "canonical_text": "آیا او حالش خوب است؟"
  },
  {
    "id": 69467,
    "canonical_text": "حالت خوب است؟"
  },
  {
    "id": 69468,
    "canonical_text": "چشم های خون افتاده"
  },
  {
    "id": 69469,
    "canonical_text": "چشم های قرمز شده"
  },
  {
    "id": 69470,
    "canonical_text": "چشم‌درد"
  },
  {
    "id": 69471,
    "canonical_text": "ساکت باشید!"
  },
  {
    "id": 69472,
    "canonical_text": "لطفا دوباره بگو."
  },
  {
    "id": 69473,
    "canonical_text": "آیا موزه هم دارد؟"
  },
  {
    "id": 69474,
    "canonical_text": "ساختمان های معروفی دارد؟"
  },
  {
    "id": 69478,
    "canonical_text": "فیلم تماشا کردن"
  },
  {
    "id": 69479,
    "canonical_text": "قدم زدن در پارک"
  },
  {
    "id": 69480,
    "canonical_text": "خبر ورزشی"
  },
  {
    "id": 69481,
    "canonical_text": "مطالعه کردن را دوست داری؟"
  },
  {
    "id": 69482,
    "canonical_text": "در باغ کار کردن"
  },
  {
    "id": 69483,
    "canonical_text": "در اینترنت گشت زدن"
  },
  {
    "id": 69484,
    "canonical_text": "سازمان آتش نشانی"
  },
  {
    "id": 69485,
    "canonical_text": "آیا کوشا هم هست؟"
  },
  {
    "id": 69486,
    "canonical_text": "آیا سخت کوش هم هست؟"
  },
  {
    "id": 69487,
    "canonical_text": "دور دنیا"
  },
  {
    "id": 69488,
    "canonical_text": "سراسر جهان"
  },
  {
    "id": 69490,
    "canonical_text": "هتل رزرو کردن"
  },
  {
    "id": 69491,
    "canonical_text": "بلیط خریدن"
  },
  {
    "id": 69492,
    "canonical_text": "عوارضی پرداخت کردن"
  },
  {
    "id": 69493,
    "canonical_text": "قطار سریع السیر سوار شدن"
  },
  {
    "id": 69494,
    "canonical_text": "برای سفر وسیله گرفتن"
  },
  {
    "id": 69496,
    "canonical_text": "فرم پر کردن"
  },
  {
    "id": 69497,
    "canonical_text": "متوجه ام!"
  },
  {
    "id": 69498,
    "canonical_text": "که اینطور!"
  },
  {
    "id": 69499,
    "canonical_text": "تعطیلات مذهبی را جشن گرفتن"
  },
  {
    "id": 69501,
    "canonical_text": "آتش بازی تماشا کردن"
  },
  {
    "id": 69502,
    "canonical_text": "ماهی قرمز"
  },
  {
    "id": 69503,
    "canonical_text": "لباس های مخصوص پوشیدن (برای مناسبت های خاص)"
  },
  {
    "id": 69504,
    "canonical_text": "خواندن سرود ملی"
  },
  {
    "id": 69505,
    "canonical_text": "کیک پختن"
  },
  {
    "id": 69506,
    "canonical_text": "کیک درست کردن"
  },
  {
    "id": 69507,
    "canonical_text": "جشن برپا کردن"
  },
  {
    "id": 69509,
    "canonical_text": "آجیل خوردن"
  },
  {
    "id": 69510,
    "canonical_text": "خیلی ممنون!"
  },
  {
    "id": 69511,
    "canonical_text": "ایمیل فرستادن"
  },
  {
    "id": 69512,
    "canonical_text": "حساب (بانکی) باز کردن"
  },
  {
    "id": 69513,
    "canonical_text": "از اتوبوس پیاده شدن"
  },
  {
    "id": 69514,
    "canonical_text": "خون اهدا کردن"
  },
  {
    "id": 69516,
    "canonical_text": "شهر را تمیز نگه داشتن"
  },
  {
    "id": 69517,
    "canonical_text": "به اورژانس آوردن"
  },
  {
    "id": 69518,
    "canonical_text": "کار داوطلبانه انجام دادن"
  },
  {
    "id": 69519,
    "canonical_text": "به اورژانس زنگ زدن"
  },
  {
    "id": 69520,
    "canonical_text": "آتش خاموش کردن"
  },
  {
    "id": 69521,
    "canonical_text": "آتش را مهار کردن"
  },
  {
    "id": 69522,
    "canonical_text": "از باجه اطلاعات پرسیدن"
  },
  {
    "id": 69523,
    "canonical_text": "به روز کردن یک وبلاگ"
  },
  {
    "id": 69524,
    "canonical_text": "مسابقه تلویزیونی تماشا کردن"
  },
  {
    "id": 69525,
    "canonical_text": "شبکه تلویزیون را عوض کردن"
  },
  {
    "id": 69526,
    "canonical_text": "کانال تلویزیون را عوض کردن"
  },
  {
    "id": 69527,
    "canonical_text": "ایمیل دریافت کردن"
  },
  {
    "id": 69528,
    "canonical_text": "چقدر جالب!"
  },
  {
    "id": 69529,
    "canonical_text": "چقدر عالی!"
  },
  {
    "id": 69530,
    "canonical_text": "چه روز قشنگی!"
  },
  {
    "id": 69532,
    "canonical_text": "لطفا مقداری میوه بخر."
  },
  {
    "id": 69533,
    "canonical_text": "اردوهای مدرسه"
  },
  {
    "id": 69534,
    "canonical_text": "(فقط) یک لحظه!"
  },
  {
    "id": 69535,
    "canonical_text": "لطفا عجله کنید!"
  },
  {
    "id": 69536,
    "canonical_text": "توجه کنید!"
  },
  {
    "id": 69537,
    "canonical_text": "به شکار رفتن"
  },
  {
    "id": 69538,
    "canonical_text": "پلاسما (خون)"
  },
  {
    "id": 69542,
    "canonical_text": "پکن (پایتخت چین)"
  },
  {
    "id": 69543,
    "canonical_text": "اخبار گوش کردن"
  },
  {
    "id": 69544,
    "canonical_text": "لطفا سکوت را رعایت کنید."
  },
  {
    "id": 69545,
    "canonical_text": "لطفا ساکت باشید."
  },
  {
    "id": 69546,
    "canonical_text": "گفتاری"
  },
  {
    "id": 69547,
    "canonical_text": "مناطق کشاورزی"
  },
  {
    "id": 69548,
    "canonical_text": "چه جالب!"
  },
  {
    "id": 69549,
    "canonical_text": "حرف زدن با خارجی ها"
  },
  {
    "id": 69550,
    "canonical_text": "زبان اشاره"
  },
  {
    "id": 69551,
    "canonical_text": "پروژه درسی"
  },
  {
    "id": 69553,
    "canonical_text": "اینجا شنا نکنید."
  },
  {
    "id": 69554,
    "canonical_text": "شنا کردن در اینجا ممنوع است."
  },
  {
    "id": 69555,
    "canonical_text": "انرژی بادی"
  },
  {
    "id": 69556,
    "canonical_text": "فارسی"
  },
  {
    "id": 69557,
    "canonical_text": "ممنون که زنگ زدی."
  },
  {
    "id": 69559,
    "canonical_text": "به اسکیت رفتن"
  },
  {
    "id": 69560,
    "canonical_text": "اسکیت کردن"
  },
  {
    "id": 69561,
    "canonical_text": "رویداد اجتماعی"
  },
  {
    "id": 69562,
    "canonical_text": "غذاهای خانگی"
  },
  {
    "id": 69563,
    "canonical_text": "نچ"
  },
  {
    "id": 69564,
    "canonical_text": "نخیر"
  },
  {
    "id": 69565,
    "canonical_text": "وضعیت سلامت عمومی"
  },
  {
    "id": 69567,
    "canonical_text": "تو بردی!"
  },
  {
    "id": 69568,
    "canonical_text": "داروهای ضدسرطان"
  },
  {
    "id": 69569,
    "canonical_text": "ساعت دیواری"
  },
  {
    "id": 69570,
    "canonical_text": "شرطی"
  },
  {
    "id": 69571,
    "canonical_text": "مشروط"
  },
  {
    "id": 69572,
    "canonical_text": "درجه حرارت بدن کسی را اندازه گرفتن"
  },
  {
    "id": 69573,
    "canonical_text": "ناگهان تصمیم به انجام کاری گرفتن"
  },
  {
    "id": 69574,
    "canonical_text": "گوش داخلی"
  },
  {
    "id": 69575,
    "canonical_text": "ناشنوایی"
  },
  {
    "id": 69576,
    "canonical_text": "ارتعاش"
  },
  {
    "id": 69577,
    "canonical_text": "لرزش"
  },
  {
    "id": 69578,
    "canonical_text": "گوش میانی"
  },
  {
    "id": 69579,
    "canonical_text": "نقش واژه (دستور زبان)"
  },
  {
    "id": 69580,
    "canonical_text": "اقسام کلمه"
  },
  {
    "id": 69581,
    "canonical_text": "لامپ ال ای دی"
  },
  {
    "id": 69582,
    "canonical_text": "خنک کننده"
  },
  {
    "id": 69583,
    "canonical_text": "انرژی خورشیدی"
  },
  {
    "id": 69584,
    "canonical_text": "گاز طبیعی"
  },
  {
    "id": 69586,
    "canonical_text": "در نیمه شب"
  },
  {
    "id": 69587,
    "canonical_text": "ماه گذشته"
  },
  {
    "id": 69588,
    "canonical_text": "تابستان قبل"
  },
  {
    "id": 69589,
    "canonical_text": "طراح وب سایت"
  },
  {
    "id": 69590,
    "canonical_text": "صنعت مسافرت"
  },
  {
    "id": 69591,
    "canonical_text": "نقطه ی انجماد"
  },
  {
    "id": 69594,
    "canonical_text": "ظاهری جدی"
  },
  {
    "id": 69595,
    "canonical_text": "همراه یخ"
  },
  {
    "id": 69596,
    "canonical_text": "شهر محل تولد"
  },
  {
    "id": 69597,
    "canonical_text": "تشک برقی"
  },
  {
    "id": 69599,
    "canonical_text": "قرص نعنایی"
  },
  {
    "id": 69600,
    "canonical_text": "قرص خوشبو کننده دهان"
  },
  {
    "id": 69601,
    "canonical_text": "ترن هوایی"
  },
  {
    "id": 69602,
    "canonical_text": "رولر کوستر"
  },
  {
    "id": 69604,
    "canonical_text": "دو طبقه"
  },
  {
    "id": 69605,
    "canonical_text": "با اسب کشیده شده"
  },
  {
    "id": 69606,
    "canonical_text": "وسوسه انگیز"
  },
  {
    "id": 69608,
    "canonical_text": "ریزریز کردن (گوشت و سبزی و...)"
  },
  {
    "id": 69609,
    "canonical_text": "قطعه‌قطعه کردن"
  },
  {
    "id": 69610,
    "canonical_text": "کره بادام زمینی"
  },
  {
    "id": 69613,
    "canonical_text": "کفش کوهنوردی"
  },
  {
    "id": 69614,
    "canonical_text": "بهتر است (که)"
  },
  {
    "id": 69615,
    "canonical_text": "متخصص (کامپیوتر)"
  },
  {
    "id": 69616,
    "canonical_text": "فیلم خانگی"
  },
  {
    "id": 69617,
    "canonical_text": "سیستم پستی"
  },
  {
    "id": 69618,
    "canonical_text": "سمعی"
  },
  {
    "id": 69619,
    "canonical_text": "شنیداری"
  },
  {
    "id": 69620,
    "canonical_text": "آشغال ریختن"
  },
  {
    "id": 69622,
    "canonical_text": "پرواز کننده"
  },
  {
    "id": 69623,
    "canonical_text": "دارای ضخامت یا ژرفا (علاوه بر طول و عرض)"
  },
  {
    "id": 69624,
    "canonical_text": "(شغلی با) درآمد بالا"
  },
  {
    "id": 69625,
    "canonical_text": "آرام و معقول"
  },
  {
    "id": 69626,
    "canonical_text": "خانه به خانه"
  },
  {
    "id": 69627,
    "canonical_text": "درب به درب"
  },
  {
    "id": 69628,
    "canonical_text": "زراعت کردن"
  },
  {
    "id": 69629,
    "canonical_text": "کشاورزی کردن"
  },
  {
    "id": 69631,
    "canonical_text": "برف پوشیده"
  },
  {
    "id": 69632,
    "canonical_text": "(قله) پوشیده از برف"
  },
  {
    "id": 69633,
    "canonical_text": "مدل (لباس)"
  },
  {
    "id": 69634,
    "canonical_text": "مدلینگ"
  },
  {
    "id": 69636,
    "canonical_text": "تروکاژ"
  },
  {
    "id": 69637,
    "canonical_text": "جلوه ویژه"
  },
  {
    "id": 69638,
    "canonical_text": "فیلم تخیلی"
  },
  {
    "id": 69639,
    "canonical_text": "فانتزی"
  },
  {
    "id": 69642,
    "canonical_text": "سخنرانی عمومی"
