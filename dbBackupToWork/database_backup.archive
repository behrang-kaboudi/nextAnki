        "updatedAt": "2026-04-07T15:10:50.514Z"
      },
      {
        "id": 832,
        "sentence_en": "The coach handed me a kickboard for swim drills.",
        "sentence_en_meaning_fa": "مربی برای تمرین‌های شنا یک تخته شنا به من داد.",
        "createdAt": "2026-04-07T15:10:50.515Z",
        "updatedAt": "2026-04-07T15:10:50.515Z"
      },
      {
        "id": 833,
        "sentence_en": "Put on a life jacket before getting in the boat.",
        "sentence_en_meaning_fa": "قبل از سوار شدن به قایق جلیقه نجات بپوش.",
        "createdAt": "2026-04-07T15:10:50.515Z",
        "updatedAt": "2026-04-07T15:10:50.515Z"
      },
      {
        "id": 834,
        "sentence_en": "I don't carry much money in cash anymore.",
        "sentence_en_meaning_fa": "من دیگر زیاد پول نقد همراه ندارم.",
        "createdAt": "2026-04-07T15:10:50.516Z",
        "updatedAt": "2026-04-07T15:10:50.516Z"
      },
      {
        "id": 835,
        "sentence_en": "He found a coin under the couch cushion.",
        "sentence_en_meaning_fa": "او یک سکه زیر کوسن مبل پیدا کرد.",
        "createdAt": "2026-04-07T15:10:50.516Z",
        "updatedAt": "2026-04-07T15:10:50.516Z"
      },
      {
        "id": 836,
        "sentence_en": "Do you have any change for the parking meter?",
        "sentence_en_meaning_fa": "برای پارکومتر پول خرد داری؟",
        "createdAt": "2026-04-07T15:10:50.516Z",
        "updatedAt": "2026-04-07T15:10:50.516Z"
      },
      {
        "id": 837,
        "sentence_en": "He prefers paper money when he tips in cash.",
        "sentence_en_meaning_fa": "او وقتی نقدی انعام می‌دهد پول کاغذی را ترجیح می‌دهد.",
        "createdAt": "2026-04-07T15:10:50.516Z",
        "updatedAt": "2026-04-07T15:10:50.516Z"
      },
      {
        "id": 838,
        "sentence_en": "I brought a small gift for your new place.",
        "sentence_en_meaning_fa": "من برای جای جدیدت یک هدیه کوچک آوردم.",
        "createdAt": "2026-04-07T15:10:50.517Z",
        "updatedAt": "2026-04-07T15:10:50.517Z"
      },
      {
        "id": 839,
        "sentence_en": "He keeps his ID in a slim card holder.",
        "sentence_en_meaning_fa": "او کارت شناسایی‌اش را در یک جاکارتی باریک نگه می‌دارد.",
        "createdAt": "2026-04-07T15:10:50.517Z",
        "updatedAt": "2026-04-07T15:10:50.517Z"
      },
      {
        "id": 840,
        "sentence_en": "She wrote a check for the rent.",
        "sentence_en_meaning_fa": "او برای اجاره یک چک نوشت.",
        "createdAt": "2026-04-07T15:10:50.518Z",
        "updatedAt": "2026-04-07T15:10:50.518Z"
      },
      {
        "id": 841,
        "sentence_en": "Keep the receipt in case you need a return.",
        "sentence_en_meaning_fa": "اگر لازم شد چیزی را پس بدهی، رسید را نگه دار.",
        "createdAt": "2026-04-07T15:10:50.518Z",
        "updatedAt": "2026-04-07T15:10:50.518Z"
      },
      {
        "id": 842,
        "sentence_en": "He filled out a bank slip at the counter.",
        "sentence_en_meaning_fa": "او در باجه یک فیش بانکی را پر کرد.",
        "createdAt": "2026-04-07T15:10:50.518Z",
        "updatedAt": "2026-04-07T15:10:50.518Z"
      },
      {
        "id": 843,
        "sentence_en": "He stored the security certificate in a safe at home.",
        "sentence_en_meaning_fa": "او اوراق بهادار (فیزیکی) را در خانه داخل یک گاوصندوق نگه داشت.",
        "createdAt": "2026-04-07T15:10:50.518Z",
        "updatedAt": "2026-04-07T15:10:50.518Z"
      },
      {
        "id": 844,
        "sentence_en": "Sign the document and email it back today.",
        "sentence_en_meaning_fa": "سند را امضا کن و امروز آن را ایمیل کن.",
        "createdAt": "2026-04-07T15:10:50.519Z",
        "updatedAt": "2026-04-07T15:10:50.519Z"
      },
      {
        "id": 845,
        "sentence_en": "I paid the bill online this morning.",
        "sentence_en_meaning_fa": "من امروز صبح قبض را آنلاین پرداخت کردم.",
        "createdAt": "2026-04-07T15:10:50.519Z",
        "updatedAt": "2026-04-07T15:10:50.519Z"
      },
      {
        "id": 846,
        "sentence_en": "She requested a printed statement for her records.",
        "sentence_en_meaning_fa": "او برای پرونده‌هایش یک صورت حساب چاپی درخواست کرد.",
        "createdAt": "2026-04-07T15:10:50.519Z",
        "updatedAt": "2026-04-07T15:10:50.519Z"
      },
      {
        "id": 847,
        "sentence_en": "She keeps her jewelry in a small box at home.",
        "sentence_en_meaning_fa": "او جواهرش را در خانه داخل یک جعبهٔ کوچک نگه می‌دارد.",
        "createdAt": "2026-04-07T15:10:50.520Z",
        "updatedAt": "2026-04-07T15:10:50.520Z"
      },
      {
        "id": 848,
        "sentence_en": "The mountain range looked pink at sunset.",
        "sentence_en_meaning_fa": "کوهستان هنگام غروب صورتی به نظر می‌رسید.",
        "createdAt": "2026-04-07T15:10:50.520Z",
        "updatedAt": "2026-04-07T15:10:50.520Z"
      },
      {
        "id": 849,
        "sentence_en": "They drove across a wide plain for hours.",
        "sentence_en_meaning_fa": "آن‌ها ساعت‌ها از روی یک دشت وسیع رانندگی کردند.",
        "createdAt": "2026-04-07T15:10:50.520Z",
        "updatedAt": "2026-04-07T15:10:50.520Z"
      },
      {
        "id": 850,
        "sentence_en": "The town sits on a high plateau.",
        "sentence_en_meaning_fa": "شهر روی یک فلات بلند قرار دارد.",
        "createdAt": "2026-04-07T15:10:50.521Z",
        "updatedAt": "2026-04-07T15:10:50.521Z"
      },
      {
        "id": 851,
        "sentence_en": "We crossed the desert with extra water and snacks.",
        "sentence_en_meaning_fa": "ما از بیابان با آب و خوراکیِ اضافه عبور کردیم.",
        "createdAt": "2026-04-07T15:10:50.521Z",
        "updatedAt": "2026-04-07T15:10:50.521Z"
      },
      {
        "id": 853,
        "sentence_en": "Fog settled over the lowland by morning.",
        "sentence_en_meaning_fa": "تا صبح مه روی جلگه نشست.",
        "createdAt": "2026-04-07T15:10:50.521Z",
        "updatedAt": "2026-04-07T15:10:50.521Z"
      },
      {
        "id": 854,
        "sentence_en": "We stopped to look down into the gorge.",
        "sentence_en_meaning_fa": "ایستادیم تا به داخل تنگه نگاه کنیم.",
        "createdAt": "2026-04-07T15:10:50.522Z",
        "updatedAt": "2026-04-07T15:10:50.522Z"
      },
      {
        "id": 855,
        "sentence_en": "Stay back from the cliff near the edge.",
        "sentence_en_meaning_fa": "نزدیک لبه از صخره فاصله بگیر.",
        "createdAt": "2026-04-07T15:10:50.522Z",
        "updatedAt": "2026-04-07T15:10:50.522Z"
      },
      {
        "id": 856,
        "sentence_en": "He stood near the precipice and looked down.",
        "sentence_en_meaning_fa": "او نزدیک پرتگاه ایستاد و پایین را نگاه کرد.",
        "createdAt": "2026-04-07T15:10:50.522Z",
        "updatedAt": "2026-04-07T15:10:50.522Z"
      },
      {
        "id": 857,
        "sentence_en": "He dug a pit for the campfire.",
        "sentence_en_meaning_fa": "او برای آتشِ کمپ یک چاله کند.",
        "createdAt": "2026-04-07T15:10:50.523Z",
        "updatedAt": "2026-04-07T15:10:50.523Z"
      },
      {
        "id": 858,
        "sentence_en": "A sinkhole opened near the road after the rain.",
        "sentence_en_meaning_fa": "بعد از باران یک گودال طبیعی نزدیک جاده باز شد.",
        "createdAt": "2026-04-07T15:10:50.523Z",
        "updatedAt": "2026-04-07T15:10:50.523Z"
      },
      {
        "id": 859,
        "sentence_en": "We walked through the forest and heard birds everywhere.",
        "sentence_en_meaning_fa": "ما از جنگل گذشتیم و همه‌جا صدای پرنده‌ها را شنیدیم.",
        "createdAt": "2026-04-07T15:10:50.523Z",
        "updatedAt": "2026-04-07T15:10:50.523Z"
      },
      {
        "id": 860,
        "sentence_en": "The rainforest was humid and full of insects.",
        "sentence_en_meaning_fa": "جنگل بارانی مرطوب بود و پر از حشره بود.",
        "createdAt": "2026-04-07T15:10:50.524Z",
        "updatedAt": "2026-04-07T15:10:50.524Z"
      },
      {
        "id": 861,
        "sentence_en": "A rabbit vanished into the thicket in seconds.",
        "sentence_en_meaning_fa": "یک خرگوش در چند ثانیه داخل بیشه ناپدید شد.",
        "createdAt": "2026-04-07T15:10:50.524Z",
        "updatedAt": "2026-04-07T15:10:50.524Z"
      },
      {
        "id": 862,
        "sentence_en": "Cows grazed in the pasture behind the barn.",
        "sentence_en_meaning_fa": "گاوها در مرتع پشت طویله چرا می‌کردند.",
