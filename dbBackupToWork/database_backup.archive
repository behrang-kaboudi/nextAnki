        "updatedAt": "2026-04-07T15:10:50.352Z"
      },
      {
        "id": 511,
        "sentence_en": "She used a nail file to smooth a rough edge.",
        "sentence_en_meaning_fa": "او با سوهان ناخن لبه زبر را صاف کرد.",
