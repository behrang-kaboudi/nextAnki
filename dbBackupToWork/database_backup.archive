        "updatedAt": "2026-04-07T15:10:50.551Z"
      },
      {
        "id": 887,
        "sentence_en": "Her hair was still wet after the shower.",
        "sentence_en_meaning_fa": "مو او بعد از دوش هنوز خیس بود.",
        "createdAt": "2026-04-07T15:10:50.551Z",
        "updatedAt": "2026-04-07T15:10:50.551Z"
      },
      {
        "id": 889,
        "sentence_en": "He bruised his leg playing basketball last night.",
        "sentence_en_meaning_fa": "او دیشب هنگام بازی بسکتبال پاش کبود شد.",
        "createdAt": "2026-04-07T15:10:50.552Z",
        "updatedAt": "2026-04-07T15:10:50.552Z"
      },
      {
        "id": 890,
        "sentence_en": "The puppy put its paw on my shoe.",
        "sentence_en_meaning_fa": "توله‌سگ پنجهش را روی کفشم گذاشت.",
