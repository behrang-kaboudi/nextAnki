        "updatedAt": "2026-04-07T15:10:50.355Z"
      },
      {
        "id": 521,
        "sentence_en": "The pharmacist showed me the ampoule before opening it.",
        "sentence_en_meaning_fa": "داروساز قبل از باز کردنش آمپول را به من نشان داد.",
