        "updatedAt": "2026-06-27T11:59:49.422Z"
      },
      {
        "id": 451,
        "sentence_en": "He grabbed the railing as the bus stopped.",
        "sentence_en_meaning_fa": "او وقتی اتوبوس ایستاد نرده را گرفت.",
        "createdAt": "2026-04-07T15:10:50.331Z",
        "updatedAt": "2026-04-07T15:10:50.331Z"
      },
      {
        "id": 452,
        "sentence_en": "The stair railing feels loose near the top.",
        "sentence_en_meaning_fa": "نرده راه پله نزدیک بالایش لق است.",
        "createdAt": "2026-04-07T15:10:50.332Z",
        "updatedAt": "2026-04-07T15:10:50.332Z"
      },
      {
        "id": 453,
        "sentence_en": "We drank coffee on the balcony every morning.",
        "sentence_en_meaning_fa": "ما هر صبح روی بالکن قهوه می‌خوردیم.",
        "createdAt": "2026-04-07T15:10:50.332Z",
        "updatedAt": "2026-04-07T15:10:50.332Z"
      },
      {
        "id": 454,
        "sentence_en": "They hosted dinner on the terrace at sunset.",
        "sentence_en_meaning_fa": "آن‌ها موقع غروب روی تراس شام خوردند.",
