        "updatedAt": "2026-04-07T15:10:50.350Z"
      },
      {
        "id": 504,
        "sentence_en": "He bought eyeshadow for a costume party.",
        "sentence_en_meaning_fa": "او برای یک مهمانی لباس‌مبدل سایه چشم خرید.",
        "createdAt": "2026-04-07T15:10:50.350Z",
        "updatedAt": "2026-04-07T15:10:50.350Z"
      },
      {
        "id": 505,
        "sentence_en": "Her nail polish chipped the next day.",
        "sentence_en_meaning_fa": "لاک ناخن او روز بعد پرید.",
        "createdAt": "2026-04-07T15:10:50.351Z",
        "updatedAt": "2026-04-07T15:10:50.351Z"
      },
      {
        "id": 506,
        "sentence_en": "She used face powder to reduce shine.",
        "sentence_en_meaning_fa": "او از پنکیک استفاده کرد تا برق پوست را کم کند.",
        "createdAt": "2026-04-07T15:10:50.351Z",
        "updatedAt": "2026-04-07T15:10:50.351Z"
      },
      {
        "id": 507,
        "sentence_en": "This foundation matches my skin tone perfectly.",
        "sentence_en_meaning_fa": "این کرم پودر کاملاً با رنگ پوست من جور است.",
