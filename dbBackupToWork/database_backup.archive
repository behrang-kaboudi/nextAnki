        "updatedAt": "2026-05-04T04:07:15.007Z"
      },
      {
        "id": 4051,
        "sentence_en": "No further questions were asked.",
        "sentence_en_meaning_fa": "هیچ سؤال اضافه‌ای پرسیده نشد.",
