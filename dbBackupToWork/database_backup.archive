      },
      {
        "id": 509,
        "sentence_en": "He used a hair trimmer to clean up the sides.",
        "sentence_en_meaning_fa": "او با ماشین اصلاح کناره‌ها را مرتب کرد.",
        "createdAt": "2026-04-07T15:10:50.352Z",
        "updatedAt": "2026-04-07T15:10:50.352Z"
      },
      {
        "id": 510,
        "sentence_en": "I keep a nail clipper in my travel bag.",
        "sentence_en_meaning_fa": "من یک ناخن گیر در کیف سفرم نگه می‌دارم.",
