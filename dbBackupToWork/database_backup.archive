      },
      {
        "id": 3833,
        "sentence_en": "They bumped my meeting to an earlier time.",
        "sentence_en_meaning_fa": "آن‌ها جلسه من را به زمان زودتر جلو انداختند.",
        "createdAt": "2026-04-29T08:43:54.209Z",
        "updatedAt": "2026-04-29T09:01:29.123Z"
      },
      {
        "id": 3834,
        "sentence_en": "The airline bumped him from the flight due to overbooking.",
        "sentence_en_meaning_fa": "خط هوایی او را به دلیل بیش‌فروشی حذف کرد.",
        "createdAt": "2026-04-29T08:43:54.211Z",
        "updatedAt": "2026-04-29T09:01:29.114Z"
      },
      {
        "id": 3835,
        "sentence_en": "She was bumped aside by the crowd at the concert.",
        "sentence_en_meaning_fa": "او در کنسرت توسط جمعیت کنار زده شد.",
