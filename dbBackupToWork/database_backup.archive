        "updatedAt": "2026-04-07T15:10:50.548Z"
      },
      {
        "id": 882,
        "sentence_en": "We looked down into the crater from the rim.",
        "sentence_en_meaning_fa": "ما از لبه به داخل دهانه آتشفشان نگاه کردیم.",
        "createdAt": "2026-04-07T15:10:50.549Z",
        "updatedAt": "2026-04-07T15:10:50.549Z"
      },
      {
        "id": 883,
        "sentence_en": "This region sits on a major fault line.",
        "sentence_en_meaning_fa": "این منطقه روی یک گسل بزرگ قرار دارد.",
