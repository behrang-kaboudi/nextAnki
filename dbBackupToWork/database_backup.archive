        "updatedAt": "2026-04-07T15:10:50.337Z"
      },
      {
        "id": 466,
        "sentence_en": "Meet me in the parking area behind the store.",
        "sentence_en_meaning_fa": "پشت فروشگاه در پارکینگ با من قرار بگذار.",
