        "updatedAt": "2026-04-29T09:00:59.149Z"
      },
      {
        "id": 3847,
        "sentence_en": "He smiled feebly and looked away.",
        "sentence_en_meaning_fa": "او ضعیفانه لبخند زد و نگاهش را برگرداند.",
        "createdAt": "2026-04-29T08:47:08.888Z",
        "updatedAt": "2026-04-29T09:00:39.833Z"
      },
      {
        "id": 3848,
        "sentence_en": "Her voice had a calming cadence during the speech.",
        "sentence_en_meaning_fa": "صدای او در طول سخنرانی یک ریتم آرامش‌بخش داشت.",
