        "updatedAt": "2026-06-13T22:01:29.139Z"
      },
      {
        "id": 3849,
        "sentence_en": "She took a brisk walk in the morning.",
        "sentence_en_meaning_fa": "او صبح یک پیاده‌روی سریع و پرانرژی انجام داد.",
        "createdAt": "2026-04-29T08:47:08.897Z",
        "updatedAt": "2026-04-29T09:00:39.821Z"
      },
      {
        "id": 3850,
        "sentence_en": "I saw him in passing on my way home.",
        "sentence_en_meaning_fa": "در راه خانه او را در حال عبور دیدم.",
        "createdAt": "2026-04-29T08:47:08.900Z",
        "updatedAt": "2026-04-29T09:00:39.815Z"
      },
      {
        "id": 3851,
        "sentence_en": "We had a passing conversation at the event.",
        "sentence_en_meaning_fa": "ما در رویداد یک گفت‌وگوی عبوری داشتیم.",
