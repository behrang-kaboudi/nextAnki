        "updatedAt": "2026-04-07T15:10:50.343Z"
      },
      {
        "id": 482,
        "sentence_en": "I washed my hands with soap and warm water.",
        "sentence_en_meaning_fa": "من با صابون و آب گرم دست‌هایم را شستم.",
        "createdAt": "2026-04-07T15:10:50.343Z",
        "updatedAt": "2026-04-07T15:10:50.343Z"
      },
      {
        "id": 483,
        "sentence_en": "The liquid soap ran out, so I refilled it.",
        "sentence_en_meaning_fa": "مایع دستشویی تمام شد، پس آن را دوباره پر کردم.",
