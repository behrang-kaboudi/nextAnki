        "updatedAt": "2026-04-07T15:10:50.583Z"
      },
      {
        "id": 963,
        "sentence_en": "The lightning lit up the sky behind the clouds.",
        "sentence_en_meaning_fa": "برق آسمان پشت ابرها را روشن کرد.",
