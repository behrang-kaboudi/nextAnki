        "updatedAt": "2026-04-07T15:10:50.533Z"
      },
      {
        "id": 872,
        "sentence_en": "An iceberg drifted past the ship in silence.",
        "sentence_en_meaning_fa": "یک کوه یخی در سکوت از کنار کشتی رد شد.",
        "createdAt": "2026-04-07T15:10:50.534Z",
        "updatedAt": "2026-04-07T15:10:50.534Z"
      },
      {
        "id": 873,
        "sentence_en": "Up north, permafrost makes it hard to build roads.",
        "sentence_en_meaning_fa": "در شمال، زمین یخ زده ساختن جاده‌ها را سخت می‌کند.",
