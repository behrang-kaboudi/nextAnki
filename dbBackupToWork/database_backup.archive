        "updatedAt": "2026-04-07T15:10:49.951Z"
      },
      {
        "id": 3230,
        "sentence_en": "I need a hand moving this heavy couch into the truck.",
        "sentence_en_meaning_fa": "برای جابه‌جا کردن این مبل سنگین به داخل کامیون کمک لازم دارم.",
