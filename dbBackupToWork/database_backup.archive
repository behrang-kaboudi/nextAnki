        "updatedAt": "2026-04-07T15:10:50.028Z"
      },
      {
        "id": 3383,
        "sentence_en": "You need to swipe your card to enter the building.",
        "sentence_en_meaning_fa": "برای ورود به ساختمان باید کارت بکشید.",
