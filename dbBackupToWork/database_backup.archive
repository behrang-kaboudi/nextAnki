        "updatedAt": "2026-04-07T15:10:50.354Z"
      },
      {
        "id": 515,
        "sentence_en": "She handed me a tissue during the movie.",
        "sentence_en_meaning_fa": "او در طول فیلم به من دستمال داد.",
        "createdAt": "2026-04-07T15:10:50.354Z",
        "updatedAt": "2026-04-07T15:10:50.354Z"
      },
      {
        "id": 516,
        "sentence_en": "He wrapped a bandage around his ankle.",
        "sentence_en_meaning_fa": "او دور مچ پایش باند بست.",
        "createdAt": "2026-04-07T15:10:50.354Z",
        "updatedAt": "2026-04-07T15:10:50.354Z"
      },
      {
        "id": 517,
        "sentence_en": "She put an adhesive bandage on the cut.",
        "sentence_en_meaning_fa": "او روی بریدگی چسب زخم گذاشت.",
        "createdAt": "2026-04-07T15:10:50.355Z",
        "updatedAt": "2026-04-07T15:10:50.355Z"
      },
      {
        "id": 518,
        "sentence_en": "The nurse covered the wound with sterile gauze.",
        "sentence_en_meaning_fa": "پرستار زخم را با گاز استریل پوشاند.",
