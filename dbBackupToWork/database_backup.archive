        "updatedAt": "2026-04-07T15:10:50.535Z"
      },
      {
        "id": 875,
        "sentence_en": "We took a ferry to the island.",
        "sentence_en_meaning_fa": "ما با کشتی به جزیره رفتیم.",
        "createdAt": "2026-04-07T15:10:50.537Z",
        "updatedAt": "2026-04-07T15:10:50.537Z"
      },
      {
        "id": 876,
        "sentence_en": "The archipelago has dozens of small islands.",
        "sentence_en_meaning_fa": "این مجمع الجزایر ده‌ها جزیرهٔ کوچک دارد.",
        "createdAt": "2026-04-07T15:10:50.537Z",
        "updatedAt": "2026-04-07T15:10:50.537Z"
      },
      {
        "id": 877,
        "sentence_en": "We spent the afternoon at the beach.",
        "sentence_en_meaning_fa": "ما بعدازظهر را در ساحل گذراندیم.",
        "createdAt": "2026-04-07T15:10:50.538Z",
        "updatedAt": "2026-04-07T15:10:50.538Z"
      },
      {
        "id": 878,
        "sentence_en": "We walked along the rocky coast at low tide.",
        "sentence_en_meaning_fa": "ما هنگام جزر در امتداد ساحل صخره ای قدم زدیم.",
        "createdAt": "2026-04-07T15:10:50.539Z",
        "updatedAt": "2026-04-07T15:10:50.539Z"
      },
      {
        "id": 879,
        "sentence_en": "The lighthouse sits on a windy cape.",
        "sentence_en_meaning_fa": "فانوس دریایی روی یک دماغه بادخیز قرار دارد.",
