        "updatedAt": "2026-04-07T15:10:50.345Z"
      },
      {
        "id": 488,
        "sentence_en": "I grabbed a towel and dried my hands.",
        "sentence_en_meaning_fa": "یک حوله برداشتم و دست‌هایم را خشک کردم.",
